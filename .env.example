# PostgreSQL connection string for storing Twitter registrations.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# SSL options (optional):
# Preferred — supply the provider's CA cert (PEM) for verified TLS:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Escape hatch — skip cert verification (NOT recommended, dev only):
# DATABASE_SSL_NO_VERIFY=true
